# Generate: openssl rand -hex 32
PXE_ADMIN_TOKEN=replace-this-with-a-random-token-before-start
# Address of the Linux Docker host on the private PXE virtual switch.
PXE_BASE_URL=http://192.168.77.2:8090
PXE_HTTP_BIND=127.0.0.1
PXE_INTERFACE=ens19
PXE_SERVER_CIDR=192.168.77.2/24
PXE_DHCP_START=192.168.77.100
PXE_DHCP_END=192.168.77.200
# Real router/NAT gateway on that private network. Compose does not create NAT.
PXE_GATEWAY=192.168.77.1
PXE_DNS=1.1.1.1
